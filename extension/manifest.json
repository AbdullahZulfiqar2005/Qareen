{
  "manifest_version": 3,
  "name": "Qareen Companion",
  "version": "2.0.0",
  "description": "Opt-in local memory with a bounded retry queue. No message sending.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:2846/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://web.whatsapp.com/*",
        "https://meet.google.com/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "qareen-companion@abdullah.org",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "personalCommunications"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "core.js",
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "incognito": "not_allowed"
}
